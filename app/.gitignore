# Gradle cache & build outputs
.gradle/
build/
**/build/
**/out/

# Local configuration (NEVER commit)
local.properties

# OS files
.DS_Store
Thumbs.db

# IntelliJ / Android Studio files
.idea/
*.iml
*.iws
*.ipr

# Android specific
captures/
output.json

# Keystore files (IMPORTANT – dacă vei folosi semnare)
*.jks
*.keystore
*.der

# Logs
*.log

# Generated by Gradle
.gradle/
**/.gradle/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Kotlin
kotlin-js-store/

# NDK / C++
.externalNativeBuild/
.cxx/

# Packaging files
*.apk
*.ap_
*.aab
*.aar

# Temporary files
*.tmp
*.temp

# Jetpack Compose preview caches
.compose-cache/

