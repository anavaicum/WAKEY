<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/dark_primary"
    app:cardUseCompatPadding="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Alarm icon (left) - decorative only -->
        <FrameLayout
            android:id="@+id/alarmIconBg"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@color/accent_blue"
            android:gravity="center">

            <ImageView
                android:id="@+id/alarmIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_alarm"
                app:tint="@color/white" />

        </FrameLayout>

        <!-- Time (center-left) - used by adapter -->
        <TextView
            android:id="@+id/alarmTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/alarmIconBg"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:text="Time: 06:30"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/white" />

        <!-- Delete button (right) - used by adapter -->
        <Button
            android:id="@+id/deleteAlarmBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Delete"
            android:textSize="12sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/button_bg"
            android:textColor="@color/white" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>
