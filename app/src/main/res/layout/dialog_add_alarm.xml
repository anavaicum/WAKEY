<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/bg_dialog_card">

    <!-- Title mic, clean -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add alarm"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <!-- Time picker direct (fără buton) -->
    <TimePicker
        android:id="@+id/timePicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:timePickerMode="spinner" />

    <!-- Days: un singur rând -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMon"
                style="@style/DayChip"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="Mon"
                android:checkable="true"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTue"
                style="@style/DayChip"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="Tue"
                android:checkable="true"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWed"
                style="@style/DayChip"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="Wed"
                android:checkable="true"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipThu"
                style="@style/DayChip"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="Thu"
                android:checkable="true"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFri"
                style="@style/DayChip"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="Fri"
                android:checkable="true"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSat"
                style="@style/DayChip"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="Sat"
                android:checkable="true"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSun"
                style="@style/DayChip"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="Sun"
                android:checkable="true"/>

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Save -->
    <Button
        android:id="@+id/btnSaveAlarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save"/>

</LinearLayout>
