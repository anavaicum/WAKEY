<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/dark_card">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Imaginea obiectului -->
        <ImageView
            android:id="@+id/imageObject"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:background="@drawable/object_image_background" />

        <!-- Iconița de bifă (vizibilă doar la selecție) -->
        <ImageView
            android:id="@+id/checkmark"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_margin="8dp"
            android:background="@drawable/checkmark_circle_bg"
            android:padding="6dp"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone"
            app:tint="@color/white" />

        <!-- Numele obiectului -->
        <TextView
            android:id="@+id/textObjectName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/imageObject"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:text="Object Name"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:gravity="center" />
    </RelativeLayout>
</androidx.cardview.widget.CardView>
