<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.wakey">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wakey">


        <!-- Ecran principal al aplicației -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Wakey.NoActionBar">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ecranul de onboarding -->
        <activity
            android:name=".activities.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.Wakey" />

        <!-- Ecranul principal după onboarding -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Wakey"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />


        <activity
            android:name=".activities.AlarmActivity"
            android:exported="false"
            android:theme="@style/Theme.Wakey" />



        <!--  ACTIVITATEA LIPSA  -->
        <activity
            android:name=".activities.AlarmRingActivity"
            android:exported="false"
            android:theme="@style/Theme.Wakey" />

        <activity
            android:name=".activities.AlarmListActivity"
            android:exported="false" />

        <!-- ACTIVITATE DE OBJECT RECOGNITION -->
        <activity android:name=".activities.ObjectScanActivity"/>


        <!-- RECEIVER-ul ALARMEI -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

    </application>
</manifest>
